{
  "name": "msg",
  "version": "0.1.0",
  "description": "Windows 微信消息浏览/导出工具",
  "main": "dist-electron/main.js",
  "author": "Ourten",
  "scripts": {
    "postinstall": "electron-builder install-app-deps && node scripts/prepare-electron-runtime.cjs",
    "dev": "node scripts/prepare-electron-runtime.cjs && vite",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/clean-dist-electron.cjs && tsc && vite build && electron-builder",
    "preview": "vite preview"
  },
  "dependencies": {
    "@hicccc77/electron-liquid-glass": "^0.3.0",
    "docx": "^9.7.1",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.2",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.9",
    "exceljs": "^4.4.0",
    "ffmpeg-static": "^5.3.0",
    "fzstd": "^0.1.1",
    "html2canvas": "^1.4.1",
    "jieba-wasm": "^2.2.0",
    "jszip": "^3.10.1",
    "koffi": "^3.1.0",
    "lucide-react": "^1.23.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.1",
    "react-virtuoso": "^4.18.10",
    "remark-gfm": "^4.0.1",
    "sherpa-onnx-node": "^1.13.3",
    "silk-wasm": "^3.7.1",
    "wechat-emojis": "^1.0.2",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.0.3",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "sass": "^1.101.0",
    "sharp": "^0.35.3",
    "typescript": "6.0.3",
    "vite": "^8.1.3",
    "vite-plugin-electron": "^1.1.0",
    "vite-plugin-electron-renderer": "^1.0.0"
  },
  "overrides": {
    "brace-expansion": "^5.0.6",
    "node-abi": ">=4.33.0",
    "exceljs": {
      "uuid": "11.1.1"
    },
    "fast-uri": "^3.1.3",
    "form-data": "^4.0.6",
    "ip-address": "^10.2.0",
    "picomatch": "^4.0.4",
    "js-yaml": "^4.3.0",
    "tar": "^7.5.19",
    "tmp": "^0.2.7",
    "immutable": "^5.1.5",
    "lodash": ">=4.17.21",
    "rollup": ">=4.0.0",
    "minimatch": ">=3.1.2",
    "ajv": ">=8.18.0"
  },
  "build": {
    "appId": "com.msg.app",
    "productName": "MSG",
    "artifactName": "${productName}-${version}-Setup.${ext}",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "public/icon.ico",
      "extraFiles": [
        {
          "from": "resources/runtime/win32/msvcp140.dll",
          "to": "."
        },
        {
          "from": "resources/runtime/win32/msvcp140_1.dll",
          "to": "."
        },
        {
          "from": "resources/runtime/win32/vcruntime140.dll",
          "to": "."
        },
        {
          "from": "resources/runtime/win32/vcruntime140_1.dll",
          "to": "."
        }
      ],
      "extraResources": [
        {
          "from": "resources/welive/win32/${arch}",
          "to": "resources/welive/win32/${arch}"
        },
        {
          "from": "resources/wcdb/win32/${arch}",
          "to": "resources/wcdb/win32/${arch}"
        },
        {
          "from": "resources/wedecrypt/win32/${arch}",
          "to": "resources/wedecrypt/win32/${arch}"
        },
        {
          "from": "resources/key/win32",
          "to": "resources/key/win32",
          "filter": [
            "${arch}/**/*"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "unicode": true,
      "installerLanguages": [
        "zh_CN",
        "en_US"
      ],
      "language": "2052",
      "displayLanguageSelector": false,
      "include": "installer.nsh",
      "installerIcon": "public/icon.ico",
      "uninstallerIcon": "public/icon.ico",
      "installerHeaderIcon": "public/icon.ico",
      "perMachine": false,
      "allowElevation": true
    },
    "extraResources": [
      {
        "from": "resources/",
        "to": "resources/",
        "filter": [
          "**/*",
          "!welive/**/*",
          "!wcdb/**/*",
          "!wedecrypt/**/*",
          "!key/**/*"
        ]
      },
      {
        "from": "public/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "public/icon.png",
        "to": "icon.png"
      },
      {
        "from": "electron/assets/wasm/",
        "to": "assets/wasm/"
      }
    ],
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "asarUnpack": [
      "node_modules/silk-wasm/**/*",
      "node_modules/sherpa-onnx-node/**/*",
      "node_modules/sherpa-onnx-*/*",
      "node_modules/sherpa-onnx-*/**/*",
      "node_modules/ffmpeg-static/**/*",
      "node_modules/@hicccc77/electron-liquid-glass/**/*",
      "resources/wedecrypt/**/*.node"
    ]
  }
}
